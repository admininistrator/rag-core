{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
    "Resource": ["arn:aws:s3:::rag-core-storage-test/*"]
  }, {
    "Effect": "Allow",
    "Action": ["s3:ListBucketVersions"],
    "Resource": ["arn:aws:s3:::rag-core-storage-test"]
  }]
}
