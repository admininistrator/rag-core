INFERENCE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
