# IMPLEMENTED in T01: typed runtime settings. Copy to .env and fill the two
# required service URLs before loading rag_core.config.Settings.
APP_ENV=development
LOG_LEVEL=INFO
API_BIND=127.0.0.1
API_PORT=8000
REQUEST_TIMEOUT_SECONDS=30
HEALTH_TIMEOUT_SECONDS=2
DATABASE_URL=
DATABASE_PASSWORD_FILE=
REDIS_URL=

# IMPLEMENTED in T02: Qdrant is a required API readiness dependency.
QDRANT_URL=

# IMPLEMENTED T09: operator-owned JSON app registry; unset denies all /v1 requests.
# Local dev CLI generates .local/auth/apps.json; never commit credentials.
AUTH_CONFIG_FILE=

# IMPLEMENTED T11: operator-owned JSON storage registry; credentials are file references.
# Used by the storage reader; business registration and worker wiring follow in T12/T19.
STORAGE_CONFIG_FILE=
API_CONFIG_FILE=
# Compose paths inside /run/config (host .local/api); no private signing key here.
RAG_AUTH_CONFIG_FILE=
RAG_STORAGE_CONFIG_FILE=
RAG_API_CONFIG_FILE=

# IMPLEMENTED T19: trusted worker JSON (Compose uses /run/secrets/worker_config).
WORKER_CONFIG_FILE=

# Keep actual credentials only in .env or a secret store.
# DESIGNED for later tasks:
QDRANT_API_KEY=
# Model URL/fingerprint, tokenizer path and bounds live in the trusted WorkerConfig JSON.
# IMPLEMENTED T23: configure only the provider selected by trusted DI code.
# Models have no default: operator chooses a currently available ID. Live gate T26.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_ATTEMPTS=2
DEEPSEEK_RETRY_BASE_SECONDS=0.25
DEEPSEEK_MAX_INPUT_TOKENS=32768
DEEPSEEK_CONTEXT_WINDOW_TOKENS=65536
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_ATTEMPTS=2
ANTHROPIC_RETRY_BASE_SECONDS=0.25
ANTHROPIC_MAX_INPUT_TOKENS=32768
ANTHROPIC_CONTEXT_WINDOW_TOKENS=65536
# DESIGNED T27:
ADMIN_SECRET=
