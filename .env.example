# IMPLEMENTED in T01: typed runtime settings. Copy to .env and fill the two
# required service URLs before loading rag_core.config.Settings.
APP_ENV=development
LOG_LEVEL=INFO
API_BIND=127.0.0.1
API_PORT=8000
REQUEST_TIMEOUT_SECONDS=30
DATABASE_URL=
REDIS_URL=

# DESIGNED for later tasks; keep actual credentials only in .env or a secret
