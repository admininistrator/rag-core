# IMPLEMENTED in T01: typed runtime settings. Copy to .env and fill the two
# required service URLs before loading rag_core.config.Settings.
APP_ENV=development
LOG_LEVEL=INFO
API_BIND=127.0.0.1
API_PORT=8000
REQUEST_TIMEOUT_SECONDS=30
HEALTH_TIMEOUT_SECONDS=2
DATABASE_URL=
DATABASE_PASSWORD_FILE=
REDIS_URL=

# IMPLEMENTED in T02: Qdrant is a required API readiness dependency.
QDRANT_URL=

# IMPLEMENTED T09: operator-owned JSON app registry; unset denies all /v1 requests.
# Local dev CLI generates .local/auth/apps.json; never commit credentials.
AUTH_CONFIG_FILE=

# DESIGNED for later tasks; keep actual credentials only in .env or a secret
# store. Exact fields are added to typed settings by their owning task.
QDRANT_API_KEY=
INFERENCE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
ADMIN_SECRET=
