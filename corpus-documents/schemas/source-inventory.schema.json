{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Verified source/license inventory v1",
  "required": [
    "schema_version",
    "verified_at",
    "datasets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "datasets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "dataset",
          "source_repository",
          "dataset_version",
          "repository_url",
          "repository_commit_date",
          "data_license",
          "code_license",
          "license_status",
          "license_references",
          "attribution",
          "sources",
          "data_commit_policy",
          "limitations"
        ],
        "properties": {
          "domain": {
            "enum": [
              "default",
              "document",
              "bilingual"
            ]
          },
          "dataset": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dataset_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "repository_url": {
            "type": "string",
            "format": "uri"
          },
          "repository_commit_date": {
            "type": "string",
            "format": "date-time"
          },
          "data_license": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "code_license": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_status": {
            "enum": [
              "verified",
              "unresolved"
            ]
          },
          "license_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "scope",
                "statement"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "scope": {
                  "enum": [
                    "dataset",
                    "code",
                    "publisher_card",
                    "source_pdf"
                  ]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "url",
                "version",
                "repository_commit",
                "git_blob_sha1",
                "expected_sha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "repository_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "git_blob_sha1": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expected_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "data_commit_policy": {
            "enum": [
              "lightweight_metadata_and_normalized_qa_with_attribution_only",
              "metadata_only_until_license_decision"
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
