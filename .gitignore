# Python bytecode and packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local Python and uv state
.venv/
.uv-cache/
.uv-python/

# Test, type-check, lint, and coverage state
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Runtime state and logs
/logs/
/runtime/
/var/
/.local/
*.log
*.pid
*.sqlite
*.sqlite3

# Database backups and generated reports
/backups/
/reports/generated/

# Downloaded or generated evaluation corpus. Scripts, manifests, lightweight
# metadata, licenses, and the user-supplied source prompt remain trackable.
corpus-documents/*/raw/
corpus-documents/*/documents/
# FinanceBench gold/evidence redistribution terms are unresolved. Keep the
# locally normalized evaluation records out of Git while retaining manifests.
corpus-documents/document/qa/
corpus-documents/.downloads/

# Model caches and weights
/.cache/huggingface/
/model-cache/
/models/
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
